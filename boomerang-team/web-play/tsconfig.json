{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@i18n/*": ["src/i18n/zh/*"] }
  },
  "include": ["src"]
}
